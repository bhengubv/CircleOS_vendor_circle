// CircleOS microG prebuilts.
//
// This file is regenerated by ~/fetch_microg.sh. Edit the script,
// not this file -- the next refetch will overwrite manual edits.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app_import {
    name: "FDroid",
    apk: "FDroid.apk",
    presigned: true,
    preprocessed: true,
    privileged: false,
    dex_preopt: { enabled: false },
}

android_app_import {
    name: "GmsCore",
    apk: "GmsCore.apk",
    presigned: true,
    preprocessed: true,
    privileged: false,
    dex_preopt: { enabled: false },
}
