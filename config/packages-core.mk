# Circle OS - CORE app group: universal across every device class (phone, tablet,
# desktop, TV, watch). Platform services, settings, security, safety, comms, input.
# NO launcher here -- each form factor picks its own home.
PRODUCT_PACKAGES += \
    CircleOsSettings \
    TrafficLobby \
    CircleSecurity \
    InferenceBridge \
    AetherHandler \
    PersonalityTile \
    CircleSetupWizard \
    CircleSystemUIOverlay \
    CircleLockscreenOverlay \
    CircleWallpaperOverlay \
    Panik \
    CircleKeyboard \
    CircleBackup \
    CircleMessages \
    CirclePeople \
    Butler \
    CircleHeyB
