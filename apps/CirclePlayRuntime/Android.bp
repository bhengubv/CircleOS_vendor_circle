//
// Circle Play Runtime (#24) — Box64 + Wine compatibility backend for the
// Circle Play library. Java orchestration only; the native pack (Box64, Wine,
// DXVK, X server, render backend) is built by tools/fetch-runtime.sh and
// installed at runtime under the app's files dir.

android_app {
    name: "CirclePlayRuntime",
    srcs: ["src/**/*.java"],
    manifest: "AndroidManifest.xml",
    certificate: "platform",
    platform_apis: true,
    jni_libs: ["libcircleplay_render"],
    optimize: {
        enabled: false,
    },
}

// The render bridge: blits the X server's shared framebuffer onto the Android
// Surface and forwards input. The X server (circle-xserver) is vendored by
// tools/fetch-runtime.sh; this is the Circle-specific Android-facing half.
cc_library_shared {
    name: "libcircleplay_render",
    srcs: ["jni/libcircleplay_render.cpp"],
    shared_libs: [
        "libandroid",
        "liblog",
    ],
    cflags: [
        "-Wall",
        "-Wno-unused-parameter",
        "-std=c++17",
    ],
}
