// Circle Play (#24) — game library / launcher front-end for the compat runtime.

android_app {
    name: "CirclePlay",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    certificate: "platform",
    platform_apis: true,
    optimize: {
        enabled: false,
    },
}
