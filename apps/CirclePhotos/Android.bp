// Circle Photos (WP-21) — local photo hub over MediaStore.

android_app {
    name: "CirclePhotos",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    certificate: "platform",
    platform_apis: true,
    optimize: {
        enabled: false,
    },
}
