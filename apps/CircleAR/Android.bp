// Circle AR Places (WP-41) — camera + sensors + OpenStreetMap place labels.

android_app {
    name: "CircleAR",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    certificate: "platform",
    platform_apis: true,
    optimize: {
        enabled: false,
    },
}
