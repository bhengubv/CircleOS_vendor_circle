// Circle Camera (WP-34..37) — Camera2 capture with preview, flash, switch.

android_app {
    name: "CircleCamera",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    certificate: "platform",
    platform_apis: true,
    optimize: {
        enabled: false,
    },
}
