// Circle Commute (WP-28) — proactive "time to leave" alerts from live location.

android_app {
    name: "CircleCommute",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    certificate: "platform",
    platform_apis: true,
    optimize: {
        enabled: false,
    },
}
