// Circle Mail (WP-24) — inbox + read + compose over the Circle mail bridge.

android_app {
    name: "CircleMail",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    certificate: "platform",
    platform_apis: true,
    optimize: {
        enabled: false,
    },
}
