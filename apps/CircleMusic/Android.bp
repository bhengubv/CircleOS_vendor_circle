// Circle Music (WP-75) — subscription library browser over the Circle music bridge.

android_app {
    name: "CircleMusic",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    certificate: "platform",
    platform_apis: true,
    optimize: {
        enabled: false,
    },
}
