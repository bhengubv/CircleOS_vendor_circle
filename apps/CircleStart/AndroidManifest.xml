<?xml version="1.0" encoding="utf-8"?>
<!--
  Circle Start — the Circle OS home screen (live-tile launcher).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="za.co.circleos.start">

    <application
        android:label="Circle Start"
        android:allowBackup="false"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".CircleStartActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:clearTaskOnLaunch="true"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="keyboardHidden|orientation|screenSize|keyboard|navigation|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
