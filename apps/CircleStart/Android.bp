// Circle Start (WP-04/05/10/11/12/13) — the Circle OS live-tile home screen.

android_app {
    name: "CircleStart",
    srcs: ["src/**/*.java"],
    manifest: "AndroidManifest.xml",
    certificate: "platform",
    platform_apis: true,
    optimize: {
        enabled: false,
    },
}
