// Circle Keyboard (WP-33) — programmatic IME, true-black Metro, predictive.

android_app {
    name: "CircleKeyboard",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    certificate: "platform",
    platform_apis: true,
    optimize: {
        enabled: false,
    },
}
