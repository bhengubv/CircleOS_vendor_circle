// Circle Desktop (WP-42-44) — external-display desktop via Presentation.

android_app {
    name: "CircleDesktop",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    certificate: "platform",
    platform_apis: true,
    optimize: {
        enabled: false,
    },
}
