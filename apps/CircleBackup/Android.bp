// Circle Backup (WP-23) — contacts backup/restore over the Circle cloud bridge.

android_app {
    name: "CircleBackup",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    certificate: "platform",
    platform_apis: true,
    optimize: {
        enabled: false,
    },
}
