// Circle Quick Share (WP-57) — phone-to-phone file transfer over Wi-Fi Direct.

android_app {
    name: "CircleQuickShare",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    certificate: "platform",
    platform_apis: true,
    optimize: {
        enabled: false,
    },
}
