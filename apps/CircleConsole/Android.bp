// Circle Console (SOS-A3) — big-picture single-app console-session front-end.

android_app {
    name: "CircleConsole",
    srcs: ["src/**/*.java"],
    manifest: "AndroidManifest.xml",
    certificate: "platform",
    platform_apis: true,
    optimize: {
        enabled: false,
    },
}
