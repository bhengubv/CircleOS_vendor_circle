<?xml version="1.0" encoding="utf-8"?>
<!-- Circle Console (SOS-A3) — single-app console-session front-end. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="za.co.circleos.console">

    <application
        android:label="Circle Console"
        android:allowBackup="false"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">

        <activity
            android:name=".ConsoleActivity"
            android:exported="true"
            android:label="Circle Console"
            android:screenOrientation="sensorLandscape"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation|smallestScreenSize|screenLayout|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
