// Circle "Hey B" (WP-26 follow-up) — always-listening wake trigger for B!.

android_app {
    name: "CircleHeyB",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    certificate: "platform",
    platform_apis: true,
    optimize: {
        enabled: false,
    },
}
