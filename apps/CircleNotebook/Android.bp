// Circle Notebook (WP-27) — user-owned store + transparency UI for B!'s memory.

android_app {
    name: "CircleNotebook",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    certificate: "platform",
    platform_apis: true,
    optimize: {
        enabled: false,
    },
}
