// Circle Glance (WP-54/74) — always-on display surface + notification count.

android_app {
    name: "CircleGlance",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    certificate: "platform",
    platform_apis: true,
    optimize: {
        enabled: false,
    },
}
