// Circle Quiet Hours (WP-31) — scheduled DND with inner-circle breakthrough.

android_app {
    name: "CircleQuietHours",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    certificate: "platform",
    platform_apis: true,
    optimize: {
        enabled: false,
    },
}
