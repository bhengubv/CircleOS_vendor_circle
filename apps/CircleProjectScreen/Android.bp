// Circle Project My Screen (WP-68) — phone-side screen capture + H.264 stream.

android_app {
    name: "CircleProjectScreen",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    certificate: "platform",
    platform_apis: true,
    optimize: {
        enabled: false,
    },
}
