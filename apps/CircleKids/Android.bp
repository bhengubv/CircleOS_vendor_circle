// Circle Kid's Corner (WP-50) — PIN-gated child mode with screen pinning.

android_app {
    name: "CircleKids",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    certificate: "platform",
    platform_apis: true,
    optimize: {
        enabled: false,
    },
}
