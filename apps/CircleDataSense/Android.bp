//
// Circle Data Sense (WP-51) — per-app + total data usage via NetworkStatsManager.

android_app {
    name: "CircleDataSense",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    certificate: "platform",
    platform_apis: true,
    optimize: {
        enabled: false,
    },
}
