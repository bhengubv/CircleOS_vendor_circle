<?xml version="1.0" encoding="utf-8"?>
<!--
  Circle OS SystemUI resource overlay.
  Themes the notification shade, quick settings, and status bar to the
  Circle OS identity: true-black surfaces, brand-blue (#2196F3) accent,
  flat Metro radii.

  Installed via PRODUCT_PACKAGES as a runtime resource overlay (RRO).
  Targets com.android.systemui.
-->
<resources>
    <!-- Quick Settings — true-black surfaces -->
    <color name="qs_background_dark">#F2000000</color>
    <color name="qs_tile_background">#FF161616</color>

    <!-- Notification shade -->
    <color name="notification_shade_background_color">#FF000000</color>
    <color name="notification_guts_bg_color">#FF161616</color>

    <!-- Notification card styling — flat Metro -->
    <dimen name="notification_corner_radius">4dp</dimen>
    <dimen name="notification_top_pad">12dp</dimen>

    <!-- Quick settings tile — flat Metro radius -->
    <dimen name="qs_tile_corner_radius">4dp</dimen>
    <dimen name="qs_tile_margin_vertical">4dp</dimen>

    <!-- Status bar -->
    <color name="status_bar_background_semi_transparent">#66000000</color>

    <!-- Accent colours for toggles — Circle brand blue -->
    <color name="qs_tile_active_color">#FF2196F3</color>
    <color name="qs_tile_inactive_color">#FF1E1E1E</color>

    <!-- Lock screen clock -->
    <color name="lockscreen_clock_color">#FFFFFFFF</color>

    <!-- Circle-specific quick settings defaults, incl. the Circle Privacy tile. -->
    <string name="quick_settings_tiles_default" translatable="false">wifi,bt,dnd,flashlight,rotation,cell,airplane,circle_privacy</string>
</resources>
