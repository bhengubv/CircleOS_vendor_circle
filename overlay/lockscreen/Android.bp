// Circle OS lock screen overlay — Circle brand clock colour,
// notification radius, and tagline as default owner info.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

runtime_resource_overlay {
    name: "CircleLockscreenOverlay",
    resource_dirs: ["res"],
    sdk_version: "current",
    certificate: "platform",
    product_specific: true,
}
